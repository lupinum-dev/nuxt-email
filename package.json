{
  "name": "nuxt-email",
  "version": "0.1.0",
  "description": "Typed Vue email authoring and server-side rendering for Nuxt",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/runtime/core.d.ts",
      "import": "./dist/runtime/core.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "core": [
        "./dist/runtime/core.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "oracle:check": "node --import tsx scripts/generate-react-oracle.ts --check",
    "oracle:write": "node --import tsx scripts/generate-react-oracle.ts --write",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@vitejs/plugin-vue": "6.0.8",
    "html-to-text": "9.0.5"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@react-email/render": "2.1.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.4.1",
    "h3": "1.15.8",
    "nuxt": "^4.4.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "6.9.0",
    "tsx": "4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8",
    "vue": "3.5.40",
    "vue-tsc": "^3.3.3"
  }
}
