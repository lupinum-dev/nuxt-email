{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "rangeStrategy": "replace",
  "schedule": ["before 6am on Monday"],
  "packageRules": [
    { "groupName": "Nuxt ecosystem", "matchPackageNames": ["nuxt", "@nuxt/**", "vue", "vue-router"] },
    {
      "description": "Review the vendored email engine and upstream oracle together",
      "groupName": "Email Tailwind compatibility",
      "matchPackageNames": ["tailwindcss", "react-email", "@react-email/render"]
    }
  ]
}
